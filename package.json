{
  "name": "termfy",
  "version": "0.2.1",
  "description": "Framework de skills da Promovaweb para construir binários de terminal em Bun com TUI, CLI e servidor MCP stdio no mesmo executável.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "skills:validar": "bun run scripts/validar-skills.ts",
    "ebook": "bun run .ebook/build-ebook.mjs",
    "ebook:verify": "bun run .ebook/build-ebook.mjs --check",
    "validar": "bun run skills:validar && bun run ebook:verify"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/termfy.git"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
